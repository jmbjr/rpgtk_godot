{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "connected-game.schema.json",
  "title": "RPG Toolkit connected game, version 1",
  "type": "object",
  "required": ["format", "schemaVersion", "archive", "root", "artifacts", "actors", "commands", "capabilities", "edges", "coverage"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "rpgtk-connected-game"},
    "schemaVersion": {"const": 1},
    "archive": {
      "type": "object",
      "required": ["name", "fileCount"],
      "additionalProperties": false,
      "properties": {"name": {"type": "string"}, "fileCount": {"type": "integer", "minimum": 0}}
    },
    "root": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "origin", "mainFile"],
          "additionalProperties": false,
          "properties": {
            "status": {"const": "configured"},
            "origin": {"enum": ["archive", "external"]},
            "mainFile": {"$ref": "#/$defs/ref"}
          }
        },
        {
          "type": "object",
          "required": ["status", "candidates"],
          "additionalProperties": false,
          "properties": {
            "status": {"const": "ambiguous"},
            "candidates": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}
          }
        },
        {
          "type": "object",
          "required": ["status"],
          "additionalProperties": false,
          "properties": {"status": {"const": "missing"}}
        }
      ]
    },
    "artifacts": {
      "type": "object",
      "propertyNames": {"pattern": "^rpgtk(?:-main)?:/"},
      "additionalProperties": {"$ref": "artifact-record.schema.json"}
    },
    "actors": {
      "type": "object",
      "propertyNames": {"pattern": "^rpgtk-actor:/"},
      "additionalProperties": {
        "type": "object",
        "required": ["$id", "name", "kind"],
        "additionalProperties": false,
        "properties": {
          "$id": {"type": "string", "pattern": "^rpgtk-actor:/"},
          "name": {"type": "string"},
          "kind": {"enum": ["character", "enemy", "toolkit-role"]}
        }
      }
    },
    "commands": {
      "type": "object",
      "propertyNames": {"pattern": "^rpgtk-command:/"},
      "additionalProperties": {
        "type": "object",
        "required": ["$id", "name", "summary", "signature", "sources"],
        "additionalProperties": false,
        "properties": {
          "$id": {"type": "string", "pattern": "^rpgtk-command:/"},
          "name": {"type": "string"},
          "summary": {"type": ["string", "null"]},
          "signature": {"type": ["string", "null"]},
          "sources": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "capabilities": {
      "type": "object",
      "propertyNames": {"pattern": "^rpgtk-capability:/"},
      "additionalProperties": {
        "type": "object",
        "required": ["$id", "code", "name"],
        "additionalProperties": false,
        "properties": {
          "$id": {"type": "string", "pattern": "^rpgtk-capability:/"},
          "code": {"type": "string"},
          "name": {"type": "string"}
        }
      }
    },
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "scriptTrace": {"$ref": "#/$defs/scriptTrace"},
    "pluginAudit": {"$ref": "#/$defs/pluginAudit"},
    "playabilityAssessment": {"$ref": "#/$defs/playabilityAssessment"},
    "coverage": {
      "type": "object",
      "required": ["decodeCounts", "referenceCounts", "limitations"],
      "additionalProperties": false,
      "properties": {
        "decodeCounts": {"$ref": "#/$defs/counts"},
        "referenceCounts": {"$ref": "#/$defs/counts"},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "playabilityAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["mainFile", "interactionProgram", "selectedInteraction", "stages",
        "movement", "summary", "gaps", "limitations"],
      "properties": {
        "mainFile": {"type": ["string", "null"]},
        "interactionProgram": {"type": ["string", "null"]},
        "selectedInteraction": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "additionalProperties": false,
             "required": ["slot", "filename", "itemPath", "activationProgram", "programPath",
               "position", "status"],
             "properties": {
               "slot": {"type": "integer", "minimum": 0},
               "filename": {"type": "string"},
               "itemPath": {"type": ["string", "null"]},
               "activationProgram": {"type": "string"},
               "programPath": {"type": ["string", "null"]},
               "position": {"$ref": "artifact-record.schema.json#/$defs/boardPosition"},
               "status": {"type": "string"}
             }}
          ]
        },
        "stages": {"type": "array", "minItems": 4, "maxItems": 4,
          "items": {"$ref": "#/$defs/playabilityStage"}},
        "movement": {"type": "array", "maxItems": 4,
          "items": {"$ref": "#/$defs/playabilityDirection"}},
        "summary": {
          "type": "object", "additionalProperties": false,
          "required": ["sourceLinked", "partial", "missing", "runtimeVerified"],
          "properties": {
            "sourceLinked": {"type": "integer", "minimum": 0, "maximum": 4},
            "partial": {"type": "integer", "minimum": 0, "maximum": 4},
            "missing": {"type": "integer", "minimum": 0, "maximum": 4},
            "runtimeVerified": {"const": false}
          }
        },
        "gaps": {"type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false,
            "required": ["id", "stage", "need", "acceptance"],
            "properties": {
              "id": {"type": "string"}, "stage": {"enum": ["title", "board", "character", "interaction"]},
              "need": {"type": "string"}, "acceptance": {"type": "string"}
            }
          }},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "playabilityRef": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence", "path", "value", "status"],
      "properties": {
        "evidence": {"type": "string"}, "path": {"type": ["string", "null"]},
        "value": {"type": "string"}, "status": {"type": "string"}
      }
    },
    "playabilityLine": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "line", "text"],
      "properties": {
        "path": {"type": "string"},
        "line": {"type": "integer", "minimum": 1}, "text": {"type": "string"}
      }
    },
    "playabilityStage": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "label", "source", "status", "references",
        "facts", "sourceLines", "runtimeStatus"],
      "properties": {
        "id": {"enum": ["title", "board", "character", "interaction"]},
        "label": {"type": "string"}, "source": {"type": ["string", "null"]},
        "status": {"enum": ["source-linked", "partial", "missing"]},
        "references": {"type": "array", "items": {"$ref": "#/$defs/playabilityRef"}},
        "facts": {"type": "array", "items": {"type": "string"}},
        "sourceLines": {"type": "array", "items": {"$ref": "#/$defs/playabilityLine"}},
        "runtimeStatus": {"const": "not-tested"}
      }
    },
    "playabilityDirection": {
      "type": "object", "additionalProperties": false,
      "required": ["direction", "value", "animation", "status", "frameCount", "frames"],
      "properties": {
        "direction": {"enum": ["South", "North", "East", "West"]},
        "value": {"type": "string"}, "animation": {"type": ["string", "null"]},
        "status": {"type": "string"}, "frameCount": {"type": "integer", "minimum": 0},
        "frames": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["image", "path", "tile", "status"],
          "properties": {
            "image": {"type": "string"}, "path": {"type": ["string", "null"]},
            "tile": {"type": ["integer", "null"], "minimum": 1},
            "status": {"type": "string"}
          }
        }}
      }
    },
    "pluginAudit": {
      "type": "object", "additionalProperties": false,
      "required": ["mainFile", "declarationScope", "storedSlots", "declarations", "bundled", "summary", "limitations"],
      "properties": {
        "mainFile": {"type": ["string", "null"]},
        "declarationScope": {"enum": ["configured", "unavailable"]},
        "storedSlots": {"type": "integer", "minimum": 0},
        "declarations": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["role", "slot", "filename", "evidence", "status", "path"],
            "properties": {
              "role": {"enum": ["slot", "menu", "fight"]},
              "slot": {"type": ["integer", "null"], "minimum": 0},
              "filename": {"type": "string", "minLength": 1},
              "evidence": {"type": "string"},
              "status": {"enum": ["resolved", "missing", "ambiguous", "unset"]},
              "path": {"type": ["string", "null"]}
            }
          }
        },
        "bundled": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "filename", "declaredAs", "pe"],
            "properties": {
              "path": {"type": "string"}, "filename": {"type": "string"},
              "declaredAs": {"type": "array", "items": {"type": "string"}},
              "pe": {"oneOf": [
                {"type": "null"},
                {"$ref": "artifact-record.schema.json#/$defs/peMetadata"}
              ]}
            }
          }
        },
        "summary": {
          "type": "object", "additionalProperties": false,
          "required": ["declared", "bundled", "undeclaredBundled", "unresolvedDeclarations",
            "comExportCandidates", "legacyExportCandidates"],
          "properties": {
            "declared": {"type": "integer", "minimum": 0},
            "bundled": {"type": "integer", "minimum": 0},
            "undeclaredBundled": {"type": "integer", "minimum": 0},
            "unresolvedDeclarations": {"type": "integer", "minimum": 0},
            "comExportCandidates": {"type": "integer", "minimum": 0},
            "legacyExportCandidates": {"type": "integer", "minimum": 0}
          }
        },
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "scriptTrace": {
      "type": "object", "additionalProperties": false,
      "required": ["mainFile", "openingBoard", "entries", "summary", "limitations"],
      "properties": {
        "mainFile": {"type": ["string", "null"]},
        "openingBoard": {"type": ["string", "null"]},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/scriptEntry"}},
        "summary": {
          "type": "object", "additionalProperties": false,
          "required": ["entryCount", "uniqueScripts", "observedImports", "unresolved", "dynamic"],
          "properties": {
            "entryCount": {"type": "integer", "minimum": 0},
            "uniqueScripts": {"type": "integer", "minimum": 0},
            "observedImports": {"type": "integer", "minimum": 0},
            "unresolved": {"type": "integer", "minimum": 0},
            "dynamic": {"type": "integer", "minimum": 0}
          }
        },
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "scriptEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "from", "path", "value", "status", "sourceLine", "trace"],
      "properties": {
        "label": {"type": "string"},
        "from": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "value": {"type": "string"},
        "status": {"type": "string"},
        "sourceLine": {"type": ["integer", "null"], "minimum": 1},
        "trace": {"$ref": "#/$defs/scriptWalk"}
      }
    },
    "scriptWalk": {
      "type": "object", "additionalProperties": false,
      "required": ["entry", "steps", "links", "gaps", "truncated"],
      "properties": {
        "entry": {"type": ["string", "null"]},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/scriptStep"}},
        "links": {"type": "array", "items": {"$ref": "#/$defs/scriptLink"}},
        "gaps": {"type": "array", "items": {"$ref": "#/$defs/scriptLink"}},
        "truncated": {"type": "boolean"}
      }
    },
    "scriptStep": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "from", "line", "directive", "depth"],
      "properties": {
        "path": {"type": "string"},
        "from": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "directive": {"type": "string"},
        "depth": {"type": "integer", "minimum": 0}
      }
    },
    "scriptLink": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "value", "directive", "line", "to", "status", "depth"],
      "properties": {
        "from": {"type": "string"},
        "value": {"type": "string"},
        "directive": {"type": "string"},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "to": {"type": ["string", "null"]},
        "status": {"type": "string"},
        "depth": {"type": "integer", "minimum": 0}
      }
    },
    "ref": {"$ref": "artifact-record.schema.json#/$defs/edge/properties/source"},
    "counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "edge": {
      "type": "object",
      "required": ["type", "source", "status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": ["startup-program", "opening-board", "initial-character", "board-tile", "board-program",
            "script-file", "asset-reference", "project-asset", "plugin-declaration",
            "defined-by", "authors", "interprets", "invokes", "implements-capability"]
        },
        "source": {"$ref": "#/$defs/ref"},
        "target": {"$ref": "artifact-record.schema.json#/$defs/edge/properties/target"},
        "status": {"$ref": "artifact-record.schema.json#/$defs/edge/properties/status"},
        "evidence": {"type": "string"},
        "value": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "placements": {"type": "integer", "minimum": 1},
        "position": {"$ref": "artifact-record.schema.json#/$defs/edge/properties/position"}
      },
      "if": {"properties": {"status": {"const": "resolved"}}},
      "then": {"required": ["target"]},
      "else": {"not": {"required": ["target"]}}
    }
  }
}
