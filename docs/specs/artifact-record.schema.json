        }
      },
      "required": [
        "byteLength",
        "name",
        "description",
        "program",
        "fightPower",
        "cost",
        "targetSpecialPower",
        "battle",
        "board",
        "storedUseFlags",
        "assets"
      ],
      "additionalProperties": false
    },
    "ste": {
      "type": "object",
      "properties": {
        "byteLength": {"type": "integer", "minimum": 0},
        "version": {"enum": [0, 2]},
        "name": {"type": "string"},
        "program": {"type": "string"},
        "rounds": {"type": "integer"},
        "hpAmount": {"type": "integer"},
        "smpAmount": {"type": "integer"},
        "speed": {"type": "boolean"},
        "slow": {"type": "boolean"},
        "disable": {"type": "boolean"},
        "removeHp": {"type": "boolean"},
        "removeSmp": {"type": "boolean"},
        "runProgram": {"type": "boolean"}
      },
      "required": [
        "byteLength",
        "version",
        "name",
        "program",
        "rounds",
        "hpAmount",
        "smpAmount",
        "speed",
        "slow",
        "disable",
        "removeHp",
        "removeSmp",
        "runProgram"
      ],
