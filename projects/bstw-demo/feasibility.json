          "when": {
            "equals": {
              "assumption": "project.target",
              "value": "digital-tk3"
            }
          },
          "inputId": "cave-tileset",
          "reason": "The recorded digital cave output is a compatible indexed TST."
        },
        {
          "id": "physical-output",
          "when": {
            "equals": {
              "assumption": "project.target",
              "value": "physical-only"
            }
          },
          "gap": "Physical representation, print dimensions, resolution and export/acceptance route are not defined.",
          "reason": "TK3 tiles do not establish a physical-game output contract."
        }
      ]
    }
  ],
  "contradictions": [
    {
      "when": {
        "allOf": [
          {
            "equals": {
