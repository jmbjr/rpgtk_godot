        "description": {"type": "string"},
        "program": {"type": "string"},
        "fightPower": {"type": "number"},
        "cost": {"type": "number"},
        "targetSpecialPower": {"type": "number"},
        "battle": {"type": "boolean"},
        "board": {"type": "boolean"},
        "storedUseFlags": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "assets": {
          "type": "object",
          "properties": {"Status effect": {"type": "string"}, "Animation": {"type": "string"}},
          "required": ["Status effect", "Animation"],
