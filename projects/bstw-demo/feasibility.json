    {
      "id": "save-reopen",
      "label": "Save and reopen editable content",
      "acceptance": "Save edited pixels, close, reopen the same revision and compare content."
    },
    {
      "id": "undo",
      "label": "Undo an edit",
      "acceptance": "Make an edit, undo it and verify the previous pixel content is restored."
    },
    {
      "id": "quick-colors",
      "label": "Switch working colors quickly",
      "acceptance": "Alternate two retained working colors repeatedly without re-entering their values."
    },
    {
      "id": "editable-layers",
      "label": "Preserve editable layers",
      "acceptance": "Edit separate layers, save/reopen, and verify independently editable content remains."
    }
