      },
      "required": ["byteLength", "width", "height", "storedFrameCount", "pauseSeconds", "frames"],
      "additionalProperties": false
    },
    "fnt": {
      "type": "object",
      "properties": {
        "byteLength": {"type": "integer", "minimum": 0},
        "width": {"const": 8},
        "height": {"const": 8},
        "glyphs": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "integer", "minimum": 0, "maximum": 255},
            "minItems": 8,
            "maxItems": 8
          },
          "minItems": 256,
          "maxItems": 256
        }
      },
      "required": ["byteLength", "width", "height", "glyphs"],
      "additionalProperties": false
    },
    "gif": {
      "type": "object",
      "properties": {
        "byteLength": {"type": "integer", "minimum": 0},
        "signature": {"enum": ["GIF87a", "GIF89a"]},
        "width": {"type": "integer", "minimum": 0},
        "height": {"type": "integer", "minimum": 0},
        "globalColors": {"type": "integer", "minimum": 0},
        "frames": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {"type": "integer", "minimum": 0},
              "y": {"type": "integer", "minimum": 0},
              "width": {"type": "integer", "minimum": 0},
              "height": {"type": "integer", "minimum": 0},
              "localColors": {"type": "integer", "minimum": 0},
              "interlaced": {"type": "boolean"},
              "delayCentiseconds": {"type": "integer", "minimum": 0},
              "disposalMethod": {"type": "integer", "minimum": 0},
